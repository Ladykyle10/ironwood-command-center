# ---------------------------------------------------------------------------
# Ironwood Command Center — environment variables
# Copy to .env.local for local development. Set the same keys in Vercel.
# With NO variables set, the app runs in DEMO MODE (browser-local data).
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings → API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key. Safe to expose; RLS enforces access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Used by scripts/seed.ts and future server-side jobs (notifications, feeds).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed app (used for auth redirects + email links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — future email notifications (Resend). Leave blank to disable.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
